{
	admin off
	default_sni {$HEARTHBOARD_DEFAULT_SNI:localhost}

	servers {
		trusted_proxies static private_ranges
	}
}

(hearthboard_common) {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src 'self'; font-src 'self' data:; frame-ancestors 'self' http://localhost https://localhost capacitor://localhost; base-uri 'self'; form-action 'self'; object-src 'none'"
		-Server
	}

	reverse_proxy hearthboard:42069
}

{$HEARTHBOARD_LOCAL_SITE_ADDRESSES:localhost 127.0.0.1 192.168.1.118} {
	tls internal
	import hearthboard_common
}

{$HEARTHBOARD_PUBLIC_DOMAIN:jodyrutter-sh.duckdns.org} {
	import hearthboard_common
}
