POSTGRES_USER=hearthboard
POSTGRES_DB=hearthboard
POSTGRES_PASSWORD=replace-with-a-strong-random-password

APP_TIMEZONE=America/Port-au-Prince
HOUSEHOLD_NAME="Hearthboard Household"
HEARTHBOARD_PUBLIC_DOMAIN=jodyrutter-sh.duckdns.org
HEARTHBOARD_LOCAL_SITE_ADDRESSES="localhost 127.0.0.1 192.168.1.220"
HEARTHBOARD_DEFAULT_SNI=192.168.1.220
INTEGRATION_PUBLIC_ORIGIN=https://jodyrutter-sh.duckdns.org

# Keep using the same OAuth credentials/encryption key you already use on the
# Windows box so accounts, sessions, and linked calendars behave consistently.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
INTEGRATION_TOKEN_ENCRYPTION_KEY=
SPEEDTEST_BACKGROUND_INTERVAL_MS=0

# Windows desktop address. Hearthboard on the Pi points Jody AI here, and the
# Pi also mounts the full-resolution drone library from this machine.
DESKTOP_HOST=192.168.1.118
DESKTOP_OLLAMA_BASE_URL=http://192.168.1.118:11434

# Your Pi already shows /dev/sda1 mounted at /mnt/media, so these defaults
# keep Hearthboard media on that USB drive instead of the SD card.
PI_MEDIA_ROOT=/mnt/media/hearthboard-media
PI_DRONE_MIRROR_DIR=/mnt/media/hearthboard-media/drone-1080p
PI_JAPAN_DIR=/mnt/media/hearthboard-media/japan
PI_GENERAL_DIR=/mnt/media/hearthboard-media/general
PI_PHONE_DIR=/mnt/media/hearthboard-media/phone
PI_PHONE_QUARANTINE_DIR=/mnt/media/hearthboard-media/phone-quarantine

# Mount the desktop's exported drone share here on the Pi. Hearthboard will
# prefer this full-res path whenever it is reachable, otherwise it falls back
# to PI_DRONE_MIRROR_DIR automatically.
PI_DRONE_FULLRES_MOUNT=/mnt/hearthboard-pc/drone-fullres
PI_JAPAN_FULLRES_MOUNT=/mnt/hearthboard-pc/japan
PI_GENERAL_FULLRES_MOUNT=/mnt/hearthboard-pc/general
PI_PHONE_FULLRES_MOUNT=/mnt/hearthboard-pc/phone
PI_PHONE_QUARANTINE_FULLRES_MOUNT=/mnt/hearthboard-pc/phone-quarantine

# SMB mount helper inputs. Replace the share names with the actual Windows
# shares you expose from the desktop.
DESKTOP_SMB_USERNAME=
DESKTOP_SMB_PASSWORD=
DESKTOP_SMB_DOMAIN=
DESKTOP_SMB_DRONE_SHARE=//192.168.1.118/HearthDrone
DESKTOP_SMB_JAPAN_SHARE=//192.168.1.118/HearthJapan
DESKTOP_SMB_GENERAL_SHARE=//192.168.1.118/HearthGeneral
DESKTOP_SMB_PHONE_SHARE=//192.168.1.118/HearthPhone
DESKTOP_SMB_PHONE_QUARANTINE_SHARE=//192.168.1.118/HearthPhoneQuarantine
